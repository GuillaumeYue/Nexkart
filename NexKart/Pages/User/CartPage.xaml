<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.User.CartPage"
             Title="Cart">
    <Grid RowDefinitions="*,Auto" BackgroundColor="#F3F0F7">

        <CollectionView x:Name="CartList" Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#EFECF4" StrokeThickness="0" Padding="10" Margin="14,5,14,5">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="13" />
                                <Label Text="{Binding Price, StringFormat='${0:0.00}'}"
                                       TextColor="#6C9C38" FontAttributes="Bold" />
                                <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}"
                                       FontSize="12" TextColor="#666666" />
                            </StackLayout>
                            <StackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Button Text="+"
                                        HeightRequest="32" WidthRequest="36"
                                        CornerRadius="4"
                                        BackgroundColor="#7AC218" TextColor="White"
                                        Clicked="OnPlusClicked" />
                                <Button Text="-"
                                        HeightRequest="32" WidthRequest="36"
                                        CornerRadius="4"
                                        Clicked="OnMinusClicked" />
                                <Button Text="X"
                                        HeightRequest="32" WidthRequest="36"
                                        CornerRadius="4"
                                        BackgroundColor="#CC3333" TextColor="White"
                                        Clicked="OnRemoveClicked" />
                            </StackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1" BackgroundColor="#E9E4EF" StrokeThickness="0" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Text="Total" FontSize="14" TextColor="#4D4D4D" />
                <Label x:Name="TotalLabel"
                       Grid.Column="1"
                       Text="$0.00"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#6C9C38" />
                <Button Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,6,0,0"
                        Text="Checkout"
                        BackgroundColor="#7AC218"
                        TextColor="White"
                        CornerRadius="6"
                        Clicked="OnCheckoutClicked" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
