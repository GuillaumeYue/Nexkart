<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.User.ProfilePage"
             Title="Profile">
    <Grid BackgroundColor="#F3F0F7">
        <ScrollView>
            <StackLayout Padding="14,14,14,12" Spacing="10">
                <Label Text="My Profile"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#383838" />

                <!-- User Info Card -->
                <Border BackgroundColor="#EFECF4" StrokeThickness="0" Padding="14">
                    <StackLayout Spacing="8">
                        <Image Source="user.png"
                               HeightRequest="70"
                               WidthRequest="70"
                               HorizontalOptions="Center" />
                        <Label x:Name="NameLabel"
                               Text=""
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="EmailLabel"
                               Text=""
                               FontSize="13"
                               TextColor="#666666"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="PhoneLabel"
                               Text=""
                               FontSize="13"
                               TextColor="#888888"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Edit Profile"
                                FontSize="12"
                                HeightRequest="34"
                                BackgroundColor="#7AC218"
                                TextColor="White"
                                CornerRadius="6"
                                HorizontalOptions="Center"
                                WidthRequest="130"
                                Clicked="OnEditProfileClicked" />
                    </StackLayout>
                </Border>

                <!-- Menu Items -->
                <Border BackgroundColor="#EFECF4" StrokeThickness="0" Padding="12">
                    <StackLayout Spacing="0">
                        <Border StrokeThickness="0" Padding="10,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMyOrdersTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="My Orders" FontAttributes="Bold" FontSize="14" />
                                <Label Grid.Column="1" Text=">" TextColor="#AAAAAA" FontSize="14" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="1" Color="#E0DDE4" />

                        <Border StrokeThickness="0" Padding="10,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Address" FontAttributes="Bold" FontSize="14" />
                                <Label Grid.Column="1" Text=">" TextColor="#AAAAAA" FontSize="14" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="1" Color="#E0DDE4" />

                        <Border StrokeThickness="0" Padding="10,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Payment Methods" FontAttributes="Bold" FontSize="14" />
                                <Label Grid.Column="1" Text=">" TextColor="#AAAAAA" FontSize="14" />
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="1" Color="#E0DDE4" />

                        <Border StrokeThickness="0" Padding="10,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Help &amp; Support" FontAttributes="Bold" FontSize="14" />
                                <Label Grid.Column="1" Text=">" TextColor="#AAAAAA" FontSize="14" />
                            </Grid>
                        </Border>
                    </StackLayout>
                </Border>

                <Button Text="Log Out"
                        BackgroundColor="#7A7A7A"
                        TextColor="White"
                        CornerRadius="6"
                        Clicked="OnLogoutClicked" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
