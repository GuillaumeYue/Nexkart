<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.User.ProfilePage"
             Title="Profile">
    <Grid BackgroundColor="#F3F0F7">
        <ScrollView>
            <StackLayout Padding="14,14,14,12" Spacing="10">
                <Label Text="My Profile"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#383838" />

                <Border BackgroundColor="#EFECF4" StrokeThickness="0" Padding="14">
                    <StackLayout Spacing="8">
                        <Image Source="user.png"
                               HeightRequest="70"
                               WidthRequest="70"
                               HorizontalOptions="Center" />
                        <Label Text="Student User"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="student@nexkart.com"
                               FontSize="13"
                               TextColor="#666666"
                               HorizontalTextAlignment="Center" />
                    </StackLayout>
                </Border>

                <Border BackgroundColor="#EFECF4" StrokeThickness="0" Padding="12">
                    <StackLayout Spacing="10">
                        <Label Text="My Orders" FontAttributes="Bold" />
                        <Label Text="Address" FontAttributes="Bold" />
                        <Label Text="Payment Methods" FontAttributes="Bold" />
                        <Label Text="Help &amp; Support" FontAttributes="Bold" />
                    </StackLayout>
                </Border>

                <Button Text="Log Out"
                        BackgroundColor="#7A7A7A"
                        TextColor="White"
                        CornerRadius="6"
                        Clicked="OnLogoutClicked" />
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
