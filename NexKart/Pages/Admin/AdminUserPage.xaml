<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.Admin.AdminUserPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="56,*,70" BackgroundColor="#F2F2F2">

        <!-- Top bar -->
        <Grid Grid.Row="0" BackgroundColor="White" Padding="16,0">
            <Label Text="ADMIN PANEL"
                   FontAttributes="Bold" FontSize="16"
                   HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <!-- User list -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Label Grid.Row="0"
                   Text="Users"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="#222222"
                   Margin="14,16,14,8" />

            <CollectionView x:Name="UserList" Grid.Row="1">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#EBEBEB" StrokeThickness="0"
                                Padding="14,12" Margin="14,4,14,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUserTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding FullName}"
                                           FontAttributes="Bold" FontSize="14" />
                                    <Label Text="{Binding Email}"
                                           TextColor="#555555" FontSize="13" />
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Role}"
                                               TextColor="#79B521" FontSize="12" FontAttributes="Bold" />
                                        <Label Grid.Column="1"
                                               Text="{Binding ActiveStatus}"
                                               TextColor="#888888" FontSize="12" />
                                    </Grid>
                                </StackLayout>
                                <Button Grid.Column="1"
                                        Text="Del"
                                        FontSize="11"
                                        HeightRequest="30"
                                        WidthRequest="44"
                                        CornerRadius="4"
                                        BackgroundColor="#CC3333"
                                        TextColor="White"
                                        Clicked="OnDeleteClicked" />
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="22" TextColor="#AAAAAA"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Bottom tab bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*"
              BackgroundColor="White" Padding="8,10">

            <StackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDashboardTabTapped" />
                </StackLayout.GestureRecognizers>
                <Image Source="home.png" HeightRequest="22" WidthRequest="22" />
                <Label Text="Dashboard" FontSize="11"
                       HorizontalTextAlignment="Center" TextColor="#4F4F4F" />
            </StackLayout>

            <StackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProductTabTapped" />
                </StackLayout.GestureRecognizers>
                <Image Source="shopping_cart.png" HeightRequest="22" WidthRequest="22" />
                <Label Text="Product" FontSize="11"
                       HorizontalTextAlignment="Center" TextColor="#4F4F4F" />
            </StackLayout>

            <StackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                <Image Source="user.png" HeightRequest="22" WidthRequest="22" />
                <Label Text="User" FontSize="11"
                       HorizontalTextAlignment="Center" TextColor="#79B521" />
            </StackLayout>

            <StackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                <StackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOrderTabTapped" />
                </StackLayout.GestureRecognizers>
                <Image Source="setting_icon.png" HeightRequest="22" WidthRequest="22" />
                <Label Text="Order" FontSize="11"
                       HorizontalTextAlignment="Center" TextColor="#4F4F4F" />
            </StackLayout>

        </Grid>

    </Grid>
</ContentPage>
