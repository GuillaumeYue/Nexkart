<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.Admin.AdminProductFormPage"
             Title="Product Form">
    <ScrollView BackgroundColor="#F2F2F2">
        <StackLayout Padding="14" Spacing="12">

            <Label x:Name="PageTitle"
                   Text="Add Product"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#222222" />

            <!-- Name -->
            <Label Text="Product Name" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Entry x:Name="NameEntry"
                       Placeholder="Enter product name"
                       FontSize="14" />
            </Border>

            <!-- Description -->
            <Label Text="Description" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Editor x:Name="DescriptionEditor"
                        Placeholder="Enter description"
                        FontSize="14"
                        HeightRequest="100"
                        AutoSize="TextChanges" />
            </Border>

            <!-- Image URL -->
            <Label Text="Image URL" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Entry x:Name="ImageEntry"
                       Placeholder="Enter image URL"
                       FontSize="14" />
            </Border>

            <!-- Price -->
            <Label Text="Price" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Entry x:Name="PriceEntry"
                       Placeholder="0.00"
                       Keyboard="Numeric"
                       FontSize="14" />
            </Border>

            <!-- Quantity -->
            <Label Text="Stock Quantity" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Entry x:Name="QuantityEntry"
                       Placeholder="0"
                       Keyboard="Numeric"
                       FontSize="14" />
            </Border>

            <!-- Save Button -->
            <Button x:Name="SaveButton"
                    Text="Add Product"
                    FontSize="15"
                    HeightRequest="44"
                    BackgroundColor="#79B521"
                    TextColor="White"
                    CornerRadius="6"
                    Margin="0,10,0,0"
                    Clicked="OnSaveClicked" />

        </StackLayout>
    </ScrollView>
</ContentPage>
