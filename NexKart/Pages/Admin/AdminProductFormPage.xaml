<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.Admin.AdminProductFormPage"
             Title="Product Form">
    <ScrollView BackgroundColor="#F2F2F2">
        <StackLayout Padding="14" Spacing="12">

            <Label x:Name="PageTitle"
                   Text="Add Product"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#222222" />

            <!-- Name -->
            <Label Text="Product Name" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Entry x:Name="NameEntry"
                       Placeholder="Enter product name"
                       FontSize="14" />
            </Border>

            <!-- Description -->
            <Label Text="Description" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Editor x:Name="DescriptionEditor"
                        Placeholder="Enter description"
                        FontSize="14"
                        HeightRequest="100"
                        AutoSize="TextChanges" />
            </Border>

            <!-- Category -->
            <Label Text="Category" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Picker x:Name="CategoryPicker" FontSize="14">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Laptops</x:String>
                            <x:String>PCs</x:String>
                            <x:String>Electronics</x:String>
                            <x:String>Watches</x:String>
                            <x:String>Smart Phones</x:String>
                            <x:String>Accessories</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>

            <!-- Image -->
            <Label Text="Product Image" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Picker x:Name="ImagePicker"
                        FontSize="14"
                        SelectedIndexChanged="OnImageSelected">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>iphone17.png</x:String>
                            <x:String>huawei_mate80.png</x:String>
                            <x:String>dell_inspiration.png</x:String>
                            <x:String>macbook_air.png</x:String>
                            <x:String>gaming_pc.png</x:String>
                            <x:String>galaxy_buds.png</x:String>
                            <x:String>homepod.png</x:String>
                            <x:String>sonyhd250.png</x:String>
                            <x:String>sonyhdp.png</x:String>
                            <x:String>smart_watch.png</x:String>
                            <x:String>switch_game.png</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </Border>
            <Image x:Name="ImagePreview"
                   HeightRequest="100"
                   Aspect="AspectFit"
                   IsVisible="False" />

            <!-- Price -->
            <Label Text="Price" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Entry x:Name="PriceEntry"
                       Placeholder="0.00"
                       Keyboard="Numeric"
                       FontSize="14" />
            </Border>

            <!-- Quantity -->
            <Label Text="Stock Quantity" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Entry x:Name="QuantityEntry"
                       Placeholder="0"
                       Keyboard="Numeric"
                       FontSize="14" />
            </Border>

            <!-- Save Button -->
            <Button x:Name="SaveButton"
                    Text="Add Product"
                    FontSize="15"
                    HeightRequest="44"
                    BackgroundColor="#79B521"
                    TextColor="White"
                    CornerRadius="6"
                    Margin="0,10,0,0"
                    Clicked="OnSaveClicked" />

        </StackLayout>
    </ScrollView>
</ContentPage>
