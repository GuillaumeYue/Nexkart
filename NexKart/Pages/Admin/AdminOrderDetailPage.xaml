<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.Admin.AdminOrderDetailPage"
             Title="Order Details">
    <ScrollView BackgroundColor="#F2F2F2">
        <StackLayout Padding="14" Spacing="12">

            <Label Text="Order Details"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#222222" />

            <!-- Order Info -->
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="12">
                <StackLayout Spacing="6">
                    <Label x:Name="OrderIdLabel" FontSize="12" TextColor="#888888" />
                    <Label x:Name="DateLabel" FontSize="13" TextColor="#555555" />
                    <Label x:Name="TotalLabel" FontSize="16" FontAttributes="Bold" TextColor="#79B521" />
                </StackLayout>
            </Border>

            <!-- Status -->
            <Label Text="Status" FontSize="13" TextColor="#555555" />
            <Border BackgroundColor="#EBEBEB" StrokeThickness="0" Padding="10,8">
                <Picker x:Name="StatusPicker" FontSize="14">
                    <Picker.Items>
                        <x:String>Pending</x:String>
                        <x:String>Processing</x:String>
                        <x:String>Shipped</x:String>
                        <x:String>Delivered</x:String>
                        <x:String>Cancelled</x:String>
                    </Picker.Items>
                </Picker>
            </Border>

            <!-- Items List -->
            <Label Text="Items"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="#555555"
                   Margin="0,6,0,0" />

            <CollectionView x:Name="ItemList" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#E0DDE4" StrokeThickness="0" Padding="10" Margin="0,2">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Spacing="2">
                                    <Label Text="{Binding ProductName}" FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}" FontSize="12" TextColor="#666666" />
                                </StackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding UnitPrice, StringFormat='${0:0.00}'}"
                                       FontAttributes="Bold" TextColor="#79B521"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Save Button -->
            <Button Text="Update Status"
                    FontSize="15"
                    HeightRequest="44"
                    BackgroundColor="#79B521"
                    TextColor="White"
                    CornerRadius="6"
                    Margin="0,10,0,0"
                    Clicked="OnSaveClicked" />

        </StackLayout>
    </ScrollView>
</ContentPage>
