<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.Auth.LoginPage"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <StackLayout Padding="24,40,24,20" Spacing="12">
                <StackLayout Orientation="Horizontal" Spacing="16">
                    <Label Text="[LOGIN]" FontAttributes="Bold" TextColor="#79B521" FontSize="24" />
                    <Button Text="SIGN UP"
                            BackgroundColor="Transparent"
                            TextColor="#8E8E8E"
                            Clicked="OnGoToSignUpClicked" />
                </StackLayout>

                <Label Text="ARE YOU REGISTERED?"
                       Margin="0,24,0,8"
                       FontAttributes="Bold"
                       FontSize="28"
                       HorizontalTextAlignment="Center"
                       TextColor="#4B4B4B" />

                <Image Source="e_icon.png" HeightRequest="90" />

                <Label Text="User name or email" TextColor="#20AFA8" FontAttributes="Bold" />
                <Entry x:Name="EmailEntry" Placeholder="Test@user.com" Keyboard="Email" />

                <Label Text="Password" TextColor="#20AFA8" FontAttributes="Bold" />
                <Entry x:Name="PasswordEntry" Placeholder="....." IsPassword="True" />

                <Label Text="Forgot Password?"
                       HorizontalOptions="Center"
                       TextColor="#79A95A"
                       TextDecorations="Underline" />

                <Button Text="Login with Google"
                        BackgroundColor="#FFFFFF"
                        TextColor="#333333"
                        Clicked="OnGoogleLoginClicked" />
            </StackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                HeightRequest="54"
                Text="[LOGIN]"
                BackgroundColor="#7AC218"
                TextColor="White"
                CornerRadius="0"
                Clicked="OnLoginClicked" />
    </Grid>
</ContentPage>
