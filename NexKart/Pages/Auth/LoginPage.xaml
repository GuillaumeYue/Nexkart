<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.Auth.LoginPage"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="26,48,26,20"
                                 Spacing="14">
                <Grid ColumnDefinitions="Auto,Auto">
                    <Label Grid.Column="0"
                           Text="[LOGIN]"
                           FontAttributes="Bold"
                           TextColor="#79B521"
                           FontSize="26" />
                    <Label Grid.Column="1"
                           Margin="26,0,0,0"
                           Text="SIGN UP"
                           TextColor="#8E8E8E"
                           FontSize="26">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGoToSignUpTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Label Text="ARE YOU REGISTERED?"
                       Margin="0,40,0,12"
                       FontAttributes="Bold"
                       FontSize="30"
                       HorizontalTextAlignment="Center"
                       TextColor="#4B4B4B" />

                <Image Source="e_icon.png"
                       HeightRequest="96"
                       Aspect="AspectFit" />

                <Label Text="User name or email"
                       Margin="0,18,0,0"
                       TextColor="#20AFA8"
                       FontAttributes="Bold"
                       FontSize="18" />
                <Entry x:Name="EmailEntry"
                       Placeholder="Test@user.com"
                       Keyboard="Email" />

                <Label Text="Password"
                       TextColor="#20AFA8"
                       FontAttributes="Bold"
                       FontSize="18" />
                <Entry x:Name="PasswordEntry"
                       Placeholder="....."
                       IsPassword="True" />

                <Label Text="Forgot Password?"
                       HorizontalOptions="Center"
                       TextColor="#79A95A"
                       FontSize="18"
                       TextDecorations="Underline" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                HeightRequest="54"
                Text="[LOGIN]"
                FontAttributes="Bold"
                BackgroundColor="#7AC218"
                TextColor="White"
                CornerRadius="0"
                Clicked="OnLoginClicked" />
    </Grid>
</ContentPage>
