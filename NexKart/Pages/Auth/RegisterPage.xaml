<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexKart.Pages.Auth.RegisterPage"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <StackLayout Padding="24,40,24,20" Spacing="12">
                <StackLayout Orientation="Horizontal" Spacing="16">
                    <Button Text="LOGIN"
                            BackgroundColor="Transparent"
                            TextColor="#8E8E8E"
                            Clicked="OnGoToLoginClicked" />
                    <Label Text="[SIGN UP]" FontAttributes="Bold" TextColor="#79B521" FontSize="24" />
                </StackLayout>

                <Label Text="CREATE YOUR ACCOUNT"
                       Margin="0,20,0,8"
                       FontAttributes="Bold"
                       FontSize="26"
                       HorizontalTextAlignment="Center"
                       TextColor="#4B4B4B" />

                <Image Source="e_icon.png" HeightRequest="80" />

                <Label Text="Full Name" TextColor="#20AFA8" FontAttributes="Bold" />
                <Entry x:Name="FullNameEntry" Placeholder="Your name" />

                <Label Text="Email" TextColor="#20AFA8" FontAttributes="Bold" />
                <Entry x:Name="EmailEntry" Placeholder="name@email.com" Keyboard="Email" />

                <Label Text="Password" TextColor="#20AFA8" FontAttributes="Bold" />
                <Entry x:Name="PasswordEntry" Placeholder="....." IsPassword="True" />

                <Label Text="Confirm Password" TextColor="#20AFA8" FontAttributes="Bold" />
                <Entry x:Name="ConfirmPasswordEntry" Placeholder="....." IsPassword="True" />

                <Button Text="Sign up with Google"
                        BackgroundColor="#FFFFFF"
                        TextColor="#333333"
                        Clicked="OnGoogleSignUpClicked" />
            </StackLayout>
        </ScrollView>

        <Button Grid.Row="1"
                HeightRequest="54"
                Text="[SIGN UP]"
                BackgroundColor="#0CA6A3"
                TextColor="White"
                CornerRadius="0"
                Clicked="OnRegisterClicked" />
    </Grid>
</ContentPage>
